# HTTP Port & Listen Address
# In Docker, HTTP_PORT controls the published host port and container port (e.g. 14488).
HTTP_PORT=8080
HTTP_ADDR=:8080

# REQUIRED. Secret key for every HTTP endpoint.
# Generate: openssl rand -hex 32
API_KEY=replace_with_a_long_random_secret_key

# PostgreSQL database owned by the whitelists DB user.
# - Same server: postgresql://whitelists:CHANGE_ME@remnawave-db:5432/whitelists
# - Separate server (standalone): postgresql://whitelists:CHANGE_ME@whitelists-db:5432/whitelists
DATABASE_URL=postgresql://whitelists:CHANGE_ME@remnawave-db:5432/whitelists
DB_MAX_CONNS=4

# Remnawave PostgreSQL database (read-only access to users, nodes_user_usage_history).
# - Same server: postgresql://whitelists_reader:CHANGE_ME_READER@remnawave-db:5432/remnawave
# - Separate server: postgresql://whitelists_reader:CHANGE_ME_READER@REMNAWAVE_IP:5432/remnawave
REMNAWAVE_DATABASE_URL=postgresql://whitelists_reader:CHANGE_ME_READER@remnawave-db:5432/remnawave
REMNAWAVE_DB_MAX_CONNS=4

# Remnawave node IDs that count as WHITELISTS traffic (comma-separated).
WHITELISTS_NODE_IDS=1,2

# Remnawave API:
# - Same server: http://remnawave:3000
# - Separate server: https://panel.yourdomain.com
REMNAWAVE_URL=http://remnawave:3000
REMNAWAVE_TOKEN=replace_with_remnawave_api_token
REMNAWAVE_HTTP_TIMEOUT=15s
REMNAWAVE_MAX_RETRIES=3

# Reset/safety settings.
# Safety margin for usage reconciliation from Remnawave history (0s for immediate on-demand count).
RECONCILE_SAFETY_MARGIN=0s
WORKER_POLL_INTERVAL=1s
OUTBOX_CLAIM_LEASE=2m
OUTBOX_RETENTION=30d
MIGRATION_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

# When enabled, the service makes the whitelist squad membership match quota:
#   used < total (or total=0) -> squad PRESENT
#   used >= total              -> squad ABSENT
# This is what automatically restores the squad after a top-up/reset.
# When enabled, quota is the source of truth for whitelist squad membership.
ENFORCE_WHITELIST_ACCESS=false
WHITELIST_SQUAD_ID=8743a041-b416-4e9f-8588-6d98d4ab1f3e
# Requires ENFORCE_WHITELIST_ACCESS=true. Calls Remnawave connections/drop
# after whitelist exhaustion to terminate currently active sessions.
DROP_CONNECTIONS_ON_LIMIT=false

# Optional webhook when a user actually crosses into 100% used.
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://example.com/webhooks/whitelists
# Generate: openssl rand -hex 64
WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_RETRIES=12
# Background retry limit for both enforcement and webhook operations.
OUTBOX_MAX_RETRIES=12

# Backward-compatible alias for older configs:
# ENFORCE_WHITELIST_LIMIT=true
